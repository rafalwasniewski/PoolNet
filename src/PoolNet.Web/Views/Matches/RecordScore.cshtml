@model RecordMatchScoreViewModel
@{
    ViewData["Title"] = "Wpisz Wynik Meczu";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card card-custom">
            <div class="card-header bg-white py-3 text-center">
                <span class="badge bg-secondary mb-1">Race to @Model.FirstToWins (do @Model.FirstToWins wygranych)</span>
                <h4 class="mb-0 fw-bold">Wprowadzanie Wyniku Meczu</h4>
            </div>
            <div class="card-body p-4">
                <form asp-action="RecordScore" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="MatchId" />
                    <input type="hidden" asp-for="FirstToWins" />
                    <input type="hidden" asp-for="Player1Nickname" />
                    <input type="hidden" asp-for="Player2Nickname" />
                    <input type="hidden" asp-for="ReturnUrl" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

                    <div class="row align-items-center text-center my-3">
                        <div class="col-5">
                            <label class="form-label fw-bold fs-5 text-truncate d-block">
                                <i class="bi bi-person text-primary"></i> @Model.Player1Nickname
                            </label>
                            <input asp-for="Player1Score" type="number" min="0" max="@Model.FirstToWins" class="form-control form-control-lg text-center fs-2 fw-bold" autofocus />
                            <span asp-validation-for="Player1Score" class="text-danger small"></span>
                        </div>
                        <div class="col-2 fs-2 fw-bold text-muted">
                            :
                        </div>
                        <div class="col-5">
                            <label class="form-label fw-bold fs-5 text-truncate d-block">
                                <i class="bi bi-person text-primary"></i> @Model.Player2Nickname
                            </label>
                            <input asp-for="Player2Score" type="number" min="0" max="@Model.FirstToWins" class="form-control form-control-lg text-center fs-2 fw-bold" />
                            <span asp-validation-for="Player2Score" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="alert alert-info py-2 small mb-4">
                        <i class="bi bi-info-circle me-1"></i>
                        Zasada bilardowa: Zwycięzca musi zdobyć dokładnie <strong>@Model.FirstToWins</strong> wygranych partii, a przegrany mniej niż @Model.FirstToWins (brak remisów).
                    </div>

                    <div class="d-flex justify-content-between">
                        @if (!string.IsNullOrEmpty(Model.ReturnUrl))
                        {
                            <a href="@Model.ReturnUrl" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left me-1"></i> Anuluj
                            </a>
                        }
                        else
                        {
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left me-1"></i> Anuluj
                            </a>
                        }
                        <button type="submit" class="btn btn-success fw-semibold px-4">
                            <i class="bi bi-check-circle me-1"></i> Zapisz wynik
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
