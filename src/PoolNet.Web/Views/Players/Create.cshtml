@model CreatePlayerViewModel
@{
    ViewData["Title"] = "Dodaj Nowego Gracza";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card card-custom">
            <div class="card-header bg-white py-3">
                <h4 class="mb-0 fw-bold"><i class="bi bi-person-plus text-success me-2"></i>Dodaj Nowego Gracza</h4>
            </div>
            <div class="card-body p-4">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

                    <div class="mb-4">
                        <label asp-for="Nickname" class="form-label fw-semibold"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-person-fill"></i></span>
                            <input asp-for="Nickname" class="form-control form-control-lg" placeholder="Wpisz unikalny pseudonim (np. Efren)" autofocus />
                        </div>
                        <span asp-validation-for="Nickname" class="text-danger small"></span>
                        <div class="form-text">
                            Zgodnie z wymaganiami, gracz jest identyfikowany wyłącznie po unikalnym pseudonimie.
                        </div>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left me-1"></i> Powrót do listy
                        </a>
                        <button type="submit" class="btn btn-success fw-semibold px-4">
                            <i class="bi bi-check-lg me-1"></i> Utwórz gracza
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
