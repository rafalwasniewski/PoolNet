@model PlayerDetailsDto
@{
    ViewData["Title"] = $"Profil gracza - {Model.Nickname}";
}

<!-- Nagłówek profilu -->
<div class="card card-custom mb-4 bg-white">
    <div class="card-body p-4 d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div class="d-flex align-items-center gap-3">
            <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 64px; height: 64px; font-size: 1.8rem;">
                🎱
            </div>
            <div>
                <h2 class="fw-bold mb-0">@Model.Nickname</h2>
                <div class="text-muted small">
                    <i class="bi bi-calendar3 me-1"></i> Gracz w systemie od @Model.CreatedAt.ToString("dd.MM.yyyy")
                </div>
            </div>
        </div>
        <div class="d-flex gap-2">
            @if (User.IsInRole("Admin"))
            {
                <a asp-controller="Matches" asp-action="CreateFriendly" class="btn btn-outline-success btn-sm">
                    <i class="bi bi-play-circle me-1"></i> Nowy mecz z tym graczem
                </a>
            }
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left me-1"></i> Wszyscy gracze
            </a>
        </div>
    </div>
</div>

<!-- Kafelki statystyk ogólnych -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="card card-custom text-center p-3">
            <div class="text-muted small text-uppercase">Rozegrane mecze</div>
            <div class="fs-2 fw-bold text-dark">@Model.OverallStats.TotalMatches</div>
            <div class="small text-muted">@Model.OverallStats.Wins wygrane / @Model.OverallStats.Losses porażki</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card card-custom text-center p-3">
            <div class="text-muted small text-uppercase">Skuteczność (Win rate)</div>
            <div class="fs-2 fw-bold text-primary">@Model.OverallStats.WinRate%</div>
            <div class="small text-muted">procent zwycięstw</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card card-custom text-center p-3">
            <div class="text-muted small text-uppercase">Partie (Frames)</div>
            <div class="fs-2 fw-bold text-dark">@Model.OverallStats.FramesWon : @Model.OverallStats.FramesLost</div>
            <div class="small text-muted">zdobyte vs stracone</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card card-custom text-center p-3">
            <div class="text-muted small text-uppercase">Bilans partii (+/-)</div>
            <div class="fs-2 fw-bold @(Model.OverallStats.FrameDifference >= 0 ? "text-success" : "text-danger")">
                @(Model.OverallStats.FrameDifference > 0 ? "+" : "")@Model.OverallStats.FrameDifference
            </div>
            <div class="small text-muted">różnica partii</div>
        </div>
    </div>
</div>

<!-- Statystyki per odmiana (8, 9, 10) -->
<div class="card card-custom mb-4">
    <div class="card-header bg-white py-3">
        <h5 class="mb-0 fw-bold"><i class="bi bi-pie-chart-fill text-warning me-2"></i>Statystyki według odmian bilarda (8, 9, 10)</h5>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light small">
                    <tr>
                        <th>Odmiana</th>
                        <th class="text-center">Mecze</th>
                        <th class="text-center">Wygrane</th>
                        <th class="text-center">Porażki</th>
                        <th class="text-center">Skuteczność</th>
                        <th class="text-center">Partie (Zdobyte : Stracone)</th>
                        <th class="text-center">Bilans (+/-)</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in Model.StatsPerGameType)
                    {
                        <tr>
                            <td>
                                @if (s.GameType == BilliardGameType.EightBall)
                                {
                                    <span class="badge badge-ball-8 me-2">8</span> <strong>@s.GameTypeName</strong>
                                }
                                else if (s.GameType == BilliardGameType.NineBall)
                                {
                                    <span class="badge badge-ball-9 me-2">9</span> <strong>@s.GameTypeName</strong>
                                }
                                else
                                {
                                    <span class="badge badge-ball-10 me-2">10</span> <strong>@s.GameTypeName</strong>
                                }
                            </td>
                            <td class="text-center">@s.TotalMatches</td>
                            <td class="text-center"><span class="badge bg-success">@s.Wins</span></td>
                            <td class="text-center"><span class="badge bg-secondary">@s.Losses</span></td>
                            <td class="text-center fw-semibold text-primary">@s.WinRate%</td>
                            <td class="text-center">@s.FramesWon : @s.FramesLost</td>
                            <td class="text-center fw-semibold @(s.FrameDifference >= 0 ? "text-success" : "text-danger")">
                                @(s.FrameDifference > 0 ? "+" : "")@s.FrameDifference
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Ligi i Turnieje gracza -->
<div class="row g-4 mb-4">
    <div class="col-md-6">
        <div class="card card-custom h-100">
            <div class="card-header bg-white py-3">
                <h5 class="mb-0 fw-bold"><i class="bi bi-trophy-fill text-success me-2"></i>Pozycja w ligach</h5>
            </div>
            <div class="card-body p-0">
                @if (Model.Leagues.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light small">
                                <tr>
                                    <th>Liga</th>
                                    <th>Odmiana</th>
                                    <th class="text-center">Miejsce</th>
                                    <th class="text-center">Punkty</th>
                                    <th class="text-end">Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var l in Model.Leagues)
                                {
                                    <tr>
                                        <td>
                                            <a asp-controller="Leagues" asp-action="Details" asp-route-id="@l.LeagueId" class="fw-semibold text-decoration-none">
                                                @l.LeagueName
                                            </a>
                                        </td>
                                        <td>Bila @((int)l.GameType)</td>
                                        <td class="text-center">
                                            <span class="badge bg-warning text-dark fw-bold">@l.Position / @l.TotalParticipants</span>
                                        </td>
                                        <td class="text-center fw-bold">@l.Points pkt</td>
                                        <td class="text-end">
                                            <span class="badge @(l.Status == LeagueStatus.Finished ? "bg-secondary" : "bg-success")">
                                                @(l.Status == LeagueStatus.Finished ? "Zakończona" : "W toku")
                                            </span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p class="text-muted text-center p-4 mb-0">Gracz nie bierze udziału w żadnej lidze.</p>
                }
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card card-custom h-100">
            <div class="card-header bg-white py-3">
                <h5 class="mb-0 fw-bold"><i class="bi bi-diagram-3-fill text-info me-2"></i>Osiągnięcia w turniejach</h5>
            </div>
            <div class="card-body p-0">
                @if (Model.Tournaments.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light small">
                                <tr>
                                    <th>Turniej</th>
                                    <th>Odmiana</th>
                                    <th class="text-center">Wynik końcowy</th>
                                    <th class="text-end">Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var t in Model.Tournaments)
                                {
                                    <tr>
                                        <td>
                                            <a asp-controller="Tournaments" asp-action="Details" asp-route-id="@t.TournamentId" class="fw-semibold text-decoration-none">
                                                @t.TournamentName
                                            </a>
                                        </td>
                                        <td>Bila @((int)t.GameType)</td>
                                        <td class="text-center fw-bold">
                                            @t.Result
                                        </td>
                                        <td class="text-end">
                                            <span class="badge @(t.Status == TournamentStatus.Finished ? "bg-secondary" : "bg-success")">
                                                @(t.Status == TournamentStatus.Finished ? "Zakończony" : "W toku")
                                            </span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p class="text-muted text-center p-4 mb-0">Gracz nie brał udziału w turniejach pucharowych.</p>
                }
            </div>
        </div>
    </div>
</div>

<!-- Historia wszystkich meczów -->
<div class="card card-custom">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
        <h5 class="mb-0 fw-bold"><i class="bi bi-clock-history text-dark me-2"></i>Historia wszystkich meczów gracza</h5>
        <span class="badge bg-secondary">@Model.MatchHistory.Count spotkań</span>
    </div>
    <div class="card-body p-0">
        @if (Model.MatchHistory.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light small">
                        <tr>
                            <th>Data</th>
                            <th>Odmiana</th>
                            <th>Rozgrywki</th>
                            <th>Przeciwnik</th>
                            <th class="text-center">Wynik</th>
                            <th class="text-center">Rozstrzygnięcie</th>
                            @if (User.IsInRole("Admin"))
                            {
                                <th class="text-end">Edycja</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var m in Model.MatchHistory)
                        {
                            <tr>
                                <td class="text-muted small">
                                    @(m.PlayedAt?.ToString("dd.MM.yyyy HH:mm") ?? "Zaplanowany")
                                </td>
                                <td>
                                    @if (m.GameType == BilliardGameType.EightBall)
                                    {
                                        <span class="badge badge-ball-8">Bila 8</span>
                                    }
                                    else if (m.GameType == BilliardGameType.NineBall)
                                    {
                                        <span class="badge badge-ball-9">Bila 9</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-ball-10">Bila 10</span>
                                    }
                                </td>
                                <td><span class="badge bg-light text-dark border">@m.ContextName</span></td>
                                <td>
                                    <a asp-action="Details" asp-route-id="@m.OpponentId" class="text-decoration-none fw-semibold">
                                        @m.OpponentNickname
                                    </a>
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-dark fs-6">@m.PlayerScore : @m.OpponentScore</span>
                                    <div class="small text-muted">do @m.FirstToWins</div>
                                </td>
                                <td class="text-center">
                                    @if (m.IsWinner)
                                    {
                                        <span class="badge bg-success"><i class="bi bi-check-lg"></i> Wygrana</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger"><i class="bi bi-x-lg"></i> Porażka</span>
                                    }
                                </td>
                                @if (User.IsInRole("Admin"))
                                {
                                    <td class="text-end">
                                        @if (m.MatchKind == MatchKind.Friendly)
                                        {
                                            <a asp-controller="Matches" asp-action="RecordScore" asp-route-id="@m.MatchId" class="btn btn-sm btn-outline-secondary py-0">
                                                Popraw wynik
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">Edytuj w lidze / turnieju</span>
                                        }
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <p class="text-muted text-center p-4 mb-0">Brak rozegranych meczów przez tego gracza.</p>
        }
    </div>
</div>
