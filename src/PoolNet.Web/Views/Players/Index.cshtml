@model List<PlayerSummaryDto>
@{
    ViewData["Title"] = "Lista Graczy";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-people-fill text-primary me-2"></i>Gracze</h2>
        <p class="text-muted mb-0">Wszyscy gracze zarejestrowani w PoolNet i ich ogólne wyniki</p>
    </div>
    @if (User.IsInRole("Admin"))
    {
        <a asp-action="Create" class="btn btn-success fw-semibold">
            <i class="bi bi-person-plus-fill me-1"></i> Dodaj gracza
        </a>
    }
</div>

<div class="card card-custom mb-4">
    <div class="card-body">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-5">
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-search"></i></span>
                    <input type="text" name="search" class="form-control" placeholder="Szukaj gracza po pseudonimie..." value="@ViewBag.Search" />
                </div>
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-primary">Filtruj</button>
                @if (!string.IsNullOrEmpty(ViewBag.Search))
                {
                    <a asp-action="Index" class="btn btn-outline-secondary">Wyczyść</a>
                }
            </div>
        </form>
    </div>
</div>

<div class="card card-custom">
    <div class="card-body p-0">
        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 50px;">#</th>
                            <th>Pseudonim (Nickname)</th>
                            <th class="text-center">Rozegrane mecze</th>
                            <th class="text-center">Wygrane</th>
                            <th class="text-center">Porażki</th>
                            <th class="text-center">Skuteczność</th>
                            <th class="text-end">Akcje</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < Model.Count; i++)
                        {
                            var player = Model[i];
                            <tr>
                                <td class="text-muted">@(i + 1)</td>
                                <td>
                                    <a asp-action="Details" asp-route-id="@player.Id" class="fw-bold fs-6 text-decoration-none text-dark">
                                        <i class="bi bi-person-badge text-primary me-1"></i> @player.Nickname
                                    </a>
                                </td>
                                <td class="text-center">@player.TotalMatches</td>
                                <td class="text-center"><span class="badge bg-success">@player.Wins</span></td>
                                <td class="text-center"><span class="badge bg-secondary">@player.Losses</span></td>
                                <td class="text-center fw-bold @(player.WinRate >= 50 ? "text-success" : "text-muted")">
                                    @player.WinRate%
                                </td>
                                <td class="text-end">
                                    <a asp-action="Details" asp-route-id="@player.Id" class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-bar-chart-fill me-1"></i> Profil i statystyki
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center p-5 text-muted">
                <i class="bi bi-person-x fs-1 mb-2"></i>
                <p>Nie znaleziono żadnych graczy spełniających kryteria.</p>
            </div>
        }
    </div>
</div>
