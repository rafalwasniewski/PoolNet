@model CreateLeagueViewModel
@{
    ViewData["Title"] = "Utwórz Nową Ligę";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card card-custom">
            <div class="card-header bg-white py-3">
                <h4 class="mb-0 fw-bold"><i class="bi bi-trophy text-success me-2"></i>Kreator Ligi Bilardowej</h4>
                <small class="text-muted">Aplikacja automatycznie wygeneruje terminarz, w którym każdy gracz rozegra z każdym rywalem dokładnie dwa mecze (mecz i rewanż).</small>
            </div>
            <div class="card-body p-4">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label fw-semibold"></label>
                        <input asp-for="Name" class="form-control form-control-lg" placeholder="np. Mistrzowska Liga Ósemki 2026" autofocus />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label asp-for="GameType" class="form-label fw-semibold"></label>
                            <select asp-for="GameType" class="form-select">
                                <option value="8">🎱 Bila 8 (Ósemka)</option>
                                <option value="9">🟡 Bila 9 (Dziewiątka)</option>
                                <option value="10">🔵 Bila 10 (Dziesiątka)</option>
                            </select>
                            <span asp-validation-for="GameType" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="RaceTo" class="form-label fw-semibold"></label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-flag-fill"></i></span>
                                <input asp-for="RaceTo" type="number" min="1" max="50" class="form-control" />
                            </div>
                            <span asp-validation-for="RaceTo" class="text-danger small"></span>
                            <div class="form-text">Liczba wygranych partii kończąca mecz ligowy.</div>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-semibold d-block">
                            Wybierz uczestników ligi (minimum 2 graczy):
                        </label>
                        <span asp-validation-for="SelectedPlayerIds" class="text-danger small d-block mb-2"></span>

                        <div class="border rounded p-3 bg-light" style="max-height: 250px; overflow-y: auto;">
                            @if (Model.AvailablePlayers.Any())
                            {
                                <div class="row g-2">
                                    @foreach (var player in Model.AvailablePlayers)
                                    {
                                        <div class="col-md-6">
                                            <div class="form-check">
                                                <input class="form-check-input" type="checkbox" name="SelectedPlayerIds" value="@player.Value" id="player_@player.Value"
                                                       @(Model.SelectedPlayerIds.Contains(int.Parse(player.Value)) ? "checked" : "") />
                                                <label class="form-check-label fw-medium" for="player_@player.Value">
                                                    @player.Text
                                                </label>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <p class="text-muted mb-0">Brak dostępnych graczy. Najpierw dodaj graczy do systemu.</p>
                            }
                        </div>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left me-1"></i> Anuluj
                        </a>
                        <button type="submit" class="btn btn-success fw-semibold px-4">
                            <i class="bi bi-calendar-plus me-1"></i> Utwórz ligę i wygeneruj terminarz
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
