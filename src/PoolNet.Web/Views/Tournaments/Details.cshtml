@model TournamentDetailsDto
@{
    ViewData["Title"] = $"Drabinka Turniejowa - {Model.Name}";
}

@functions {
    string GetFeederLabel(TournamentDetailsDto model, int roundNumber, int matchOrder, int slot)
    {
        if (roundNumber <= 1) return "TBD";
        int feederMatchNumber = (matchOrder * 2 + (slot - 1)) + 1;
        return $"Zw. meczu #{feederMatchNumber}";
    }
}

<!-- Nagłówek Turnieju -->
<div class="card card-custom mb-4 bg-white">
    <div class="card-body p-4 d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge @(Model.Status == TournamentStatus.Finished ? "bg-secondary" : "bg-success")">
                    @(Model.Status == TournamentStatus.Finished ? "Zakończony" : "W toku")
                </span>
                @if (Model.GameType == BilliardGameType.EightBall)
                {
                    <span class="badge badge-ball-8">Bila 8 (Ósemka)</span>
                }
                else if (Model.GameType == BilliardGameType.NineBall)
                {
                    <span class="badge badge-ball-9">Bila 9 (Dziewiątka)</span>
                }
                else
                {
                    <span class="badge badge-ball-10">Bila 10 (Dziesiątka)</span>
                }
                <span class="badge bg-light text-dark border">Race to @Model.RaceTo</span>
            </div>
            <h2 class="fw-bold mb-0">@Model.Name</h2>
            <small class="text-muted">
                System pucharowy pojedynczej eliminacji &bull; Uczestników: @Model.Participants.Count
            </small>
        </div>
        <div>
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i> Lista turniejów
            </a>
        </div>
    </div>
</div>

@if (Model.Status == TournamentStatus.Finished && !string.IsNullOrEmpty(Model.WinnerNickname))
{
    <div class="alert alert-warning border-warning shadow-sm d-flex align-items-center justify-content-between p-3 mb-4 rounded-3">
        <div class="d-flex align-items-center gap-3">
            <span style="font-size: 2.5rem;">🏆</span>
            <div>
                <h4 class="fw-bold mb-0 text-dark">Zwycięzca Turnieju: @Model.WinnerNickname</h4>
                <div class="small text-muted">Gratulacje dla mistrza rozgrywek pucharowych!</div>
            </div>
        </div>
        <a asp-controller="Players" asp-action="Details" asp-route-id="@Model.WinnerId" class="btn btn-dark btn-sm">
            Profil mistrza
        </a>
    </div>
}

<!-- Wizualna Drabinka Turniejowa -->
<div class="card card-custom mb-4">
    <div class="card-header bg-white py-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
        <h5 class="mb-0 fw-bold"><i class="bi bi-diagram-3-fill text-primary me-2"></i>Drabinka Pucharowa</h5>
        <span class="small text-muted">
            <i class="bi bi-info-circle me-1"></i>Linie łączą mecze i wskazują awans zwycięzcy w każdej parze
        </span>
    </div>
    <div class="card-body p-4">
        <!-- Pasek nawigacji i legenda -->
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3 p-2 bg-white rounded border">
            <div class="d-flex align-items-center gap-2 flex-wrap">
                <span class="small fw-bold text-muted me-1"><i class="bi bi-arrows-expand me-1"></i>Nawigacja:</span>
                <button type="button" class="btn btn-sm btn-outline-secondary js-scroll-round" data-target="first">
                    <i class="bi bi-skip-start-fill me-1"></i>1. Runda
                </button>
                <button type="button" class="btn btn-sm btn-outline-secondary js-scroll-round" data-target="last">
                    Finał i Mistrz <i class="bi bi-trophy-fill text-warning ms-1"></i>
                </button>
            </div>
            <div class="d-flex align-items-center gap-3 small text-muted flex-wrap">
                <span class="d-flex align-items-center gap-1">
                    <span style="display:inline-block; width: 22px; height: 3px; background: #10b981; border-radius: 2px;"></span>
                    <span class="text-dark fw-semibold">Awans zwycięzcy</span>
                </span>
                <span class="d-flex align-items-center gap-1">
                    <span style="display:inline-block; width: 22px; height: 2px; border-top: 2px dashed #94a3b8;"></span>
                    <span>Oczekuje na wynik</span>
                </span>
                <span class="d-flex align-items-center gap-1">
                    <span style="display:inline-block; width: 22px; height: 3px; background: #f59e0b; border-radius: 2px;"></span>
                    <span class="text-dark fw-semibold">Ścieżka mistrza 🏆</span>
                </span>
            </div>
        </div>

        <div class="tournament-bracket-wrapper" id="tournamentBracketWrapper">
            <div class="tournament-bracket-stage" id="tournamentBracketStage">
                <!-- SVG Canvas dla połączeń między meczami -->
                <svg id="tournamentBracketSvg" class="tournament-bracket-svg" xmlns="http://www.w3.org/2000/svg">
                    <defs>
                        <!-- Grot strzałki dla ścieżki zwycięzcy (zielony) -->
                        <marker id="arrow-winner" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
                            <path d="M 0 1.5 L 8 5 L 0 8.5 z" fill="#10b981" />
                        </marker>
                        <!-- Grot strzałki dla meczu oczekującego (szary) -->
                        <marker id="arrow-pending" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
                            <path d="M 0 1.5 L 8 5 L 0 8.5 z" fill="#94a3b8" />
                        </marker>
                        <!-- Grot strzałki dla mistrza turnieju (złoty) -->
                        <marker id="arrow-champion" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
                            <path d="M 0 1.5 L 8 5 L 0 8.5 z" fill="#f59e0b" />
                        </marker>
                        <!-- Poświata dla linii zwycięzcy -->
                        <filter id="glow-winner" x="-30%" y="-30%" width="160%" height="160%">
                            <feDropShadow dx="0" dy="0" stdDeviation="2.5" flood-color="#10b981" flood-opacity="0.45"/>
                        </filter>
                    </defs>
                    <g id="bracketPathsGroup"></g>
                </svg>

                <!-- Kolumny rund pucharowych -->
                <div class="tournament-rounds d-flex" id="tournamentRounds" style="column-gap: 56px; min-width: @((Model.Rounds.Count + 1) * 336)px;">
                    @foreach (var round in Model.Rounds)
                    {
                        <div class="tournament-column d-flex flex-column flex-grow-1">
                            <div class="text-center p-2 mb-3 bg-dark text-white rounded fw-bold small text-uppercase tracking-wider shadow-sm">
                                @round.RoundName
                            </div>

                            <div class="d-flex flex-column justify-content-around flex-grow-1">
                                @foreach (var match in round.Matches)
                                {
                                    bool isP1Winner = match.WinnerId.HasValue && match.WinnerId == match.Player1Id;
                                    bool isP2Winner = match.WinnerId.HasValue && match.WinnerId == match.Player2Id;
                                    bool isP1Loser = match.IsCompleted && !isP1Winner && !match.IsBye;
                                    bool isP2Loser = match.IsCompleted && !isP2Winner && !match.IsBye;

                                    <div class="tournament-node @(match.IsCompleted ? "completed" : "") @(match.WinnerId.HasValue ? "has-winner" : "") shadow-sm"
                                         id="tmatch-@match.TournamentMatchId"
                                         data-match-id="@match.TournamentMatchId"
                                         data-round="@round.RoundNumber"
                                         data-match-order="@match.MatchOrder"
                                         data-next-match-id="@(match.NextTournamentMatchId?.ToString() ?? "")"
                                         data-next-slot="@(match.NextMatchSlot?.ToString() ?? "")"
                                         data-winner-id="@(match.WinnerId?.ToString() ?? "")"
                                         data-completed="@(match.IsCompleted.ToString().ToLower())"
                                         data-is-bye="@(match.IsBye.ToString().ToLower())">

                                        <!-- Nagłówek meczu z numerem i statusem -->
                                        <div class="d-flex justify-content-between align-items-center small text-muted mb-2 border-bottom pb-1">
                                            <span class="fw-bold">Mecz #@(match.MatchOrder + 1)</span>
                                            @if (match.IsBye)
                                            {
                                                <span class="badge badge-bye">
                                                    <i class="bi bi-forward-fill me-1"></i>Wolny los
                                                </span>
                                            }
                                            else if (match.IsCompleted)
                                            {
                                                <span class="badge bg-success">
                                                    <i class="bi bi-check2-circle me-1"></i>Zakończony
                                                </span>
                                            }
                                            else if (match.Player1Id.HasValue && match.Player2Id.HasValue)
                                            {
                                                <span class="badge bg-warning text-dark">
                                                    <i class="bi bi-play-circle me-1"></i>Gotowy do gry
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-light text-muted border">
                                                    <i class="bi bi-hourglass-split me-1"></i>Czeka na graczy
                                                </span>
                                            }
                                        </div>

                                        <!-- Gracz 1 -->
                                        <div class="tournament-slot slot-1 d-flex justify-content-between align-items-center py-1 px-2 rounded mb-1 @(isP1Winner ? "winner-slot" : (isP1Loser ? "loser-slot" : ""))"
                                             id="tmatch-@match.TournamentMatchId-slot1"
                                             data-player-id="@(match.Player1Id?.ToString() ?? "")">
                                            <div class="d-flex align-items-center text-truncate me-2">
                                                @if (match.Player1Id.HasValue)
                                                {
                                                    <i class="bi bi-person-fill @(isP1Winner ? "text-success" : (isP1Loser ? "text-muted" : "text-primary")) me-1"></i>
                                                    <a asp-controller="Players" asp-action="Details" asp-route-id="@match.Player1Id"
                                                       class="text-decoration-none fw-semibold text-truncate @(isP1Winner ? "text-success" : (isP1Loser ? "text-muted" : "text-dark"))"
                                                       title="@match.Player1Nickname">
                                                        @match.Player1Nickname
                                                    </a>
                                                    @if (isP1Winner)
                                                    {
                                                        <span class="badge badge-advance ms-2" title="Awans do kolejnego etapu">
                                                            <i class="bi bi-arrow-right-short"></i> Awans
                                                        </span>
                                                    }
                                                }
                                                else
                                                {
                                                    <span class="text-muted fst-italic small text-truncate" title="@GetFeederLabel(Model, round.RoundNumber, match.MatchOrder, 1)">
                                                        <i class="bi bi-arrow-return-right me-1"></i>@GetFeederLabel(Model, round.RoundNumber, match.MatchOrder, 1)
                                                    </span>
                                                }
                                            </div>
                                            <div>
                                                @if (match.Player1Id.HasValue)
                                                {
                                                    <span class="badge @(isP1Winner ? "bg-success shadow-sm" : (isP1Loser ? "bg-secondary opacity-75" : "bg-dark")) px-2">
                                                        @match.Player1Score
                                                    </span>
                                                }
                                            </div>
                                        </div>

                                        <!-- Gracz 2 -->
                                        <div class="tournament-slot slot-2 d-flex justify-content-between align-items-center py-1 px-2 rounded @(isP2Winner ? "winner-slot" : (isP2Loser ? "loser-slot" : ""))"
                                             id="tmatch-@match.TournamentMatchId-slot2"
                                             data-player-id="@(match.Player2Id?.ToString() ?? "")">
                                            <div class="d-flex align-items-center text-truncate me-2">
                                                @if (match.IsBye)
                                                {
                                                    <span class="text-muted small fst-italic">Brak rywala (BYE)</span>
                                                }
                                                else if (match.Player2Id.HasValue)
                                                {
                                                    <i class="bi bi-person-fill @(isP2Winner ? "text-success" : (isP2Loser ? "text-muted" : "text-primary")) me-1"></i>
                                                    <a asp-controller="Players" asp-action="Details" asp-route-id="@match.Player2Id"
                                                       class="text-decoration-none fw-semibold text-truncate @(isP2Winner ? "text-success" : (isP2Loser ? "text-muted" : "text-dark"))"
                                                       title="@match.Player2Nickname">
                                                        @match.Player2Nickname
                                                    </a>
                                                    @if (isP2Winner)
                                                    {
                                                        <span class="badge badge-advance ms-2" title="Awans do kolejnego etapu">
                                                            <i class="bi bi-arrow-right-short"></i> Awans
                                                        </span>
                                                    }
                                                }
                                                else
                                                {
                                                    <span class="text-muted fst-italic small text-truncate" title="@GetFeederLabel(Model, round.RoundNumber, match.MatchOrder, 2)">
                                                        <i class="bi bi-arrow-return-right me-1"></i>@GetFeederLabel(Model, round.RoundNumber, match.MatchOrder, 2)
                                                    </span>
                                                }
                                            </div>
                                            @if (!match.IsBye && match.Player2Id.HasValue)
                                            {
                                                <div>
                                                    <span class="badge @(isP2Winner ? "bg-success shadow-sm" : (isP2Loser ? "bg-secondary opacity-75" : "bg-dark")) px-2">
                                                        @match.Player2Score
                                                    </span>
                                                </div>
                                            }
                                        </div>

                                        <!-- Przycisk wprowadzania wyniku dla Admina -->
                                        @if (User.IsInRole("Admin") && match.CanEdit)
                                        {
                                            <div class="mt-2 pt-2 border-top text-end">
                                                <button type="button" class="btn btn-sm btn-outline-primary py-0 js-tournament-score"
                                                        data-match-id="@match.TournamentMatchId"
                                                        data-player1="@match.Player1Nickname"
                                                        data-player2="@match.Player2Nickname"
                                                        data-score1="@match.Player1Score"
                                                        data-score2="@match.Player2Score"
                                                        data-round="@round.RoundName">
                                                    @(match.IsCompleted ? "Zmień wynik" : "Wpisz wynik")
                                                </button>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    <!-- Kolumna Mistrza Turnieju -->
                    <div class="tournament-column d-flex flex-column flex-grow-1">
                        <div class="text-center p-2 mb-3 bg-warning text-dark rounded fw-bold small text-uppercase tracking-wider shadow-sm">
                            <i class="bi bi-trophy-fill me-1"></i> Mistrz Turnieju
                        </div>

                        <div class="d-flex flex-column justify-content-center flex-grow-1">
                            <div class="tournament-node tournament-champion-node text-center p-3 shadow-sm @(Model.Status == TournamentStatus.Finished ? "border-warning" : "")"
                                 id="tournamentChampionNode">
                                @if (Model.Status == TournamentStatus.Finished && !string.IsNullOrEmpty(Model.WinnerNickname))
                                {
                                    <div class="display-6 mb-2">🏆</div>
                                    <div class="badge bg-warning text-dark mb-1 fw-bold">MISTRZ PUCHARU</div>
                                    <h5 class="fw-bold text-dark mb-1">
                                        <a asp-controller="Players" asp-action="Details" asp-route-id="@Model.WinnerId" class="text-decoration-none text-dark">
                                            @Model.WinnerNickname
                                        </a>
                                    </h5>
                                    <small class="text-success fw-bold d-block mb-2">
                                        <i class="bi bi-check-circle-fill me-1"></i>Zwycięzca turnieju
                                    </small>
                                    <a asp-controller="Players" asp-action="Details" asp-route-id="@Model.WinnerId" class="btn btn-sm btn-dark">
                                        Profil mistrza
                                    </a>
                                }
                                else
                                {
                                    <div class="display-6 text-muted mb-2 opacity-50">🏆</div>
                                    <div class="text-muted fw-semibold">Czeka na mistrza</div>
                                    <small class="text-muted d-block mt-1">Zwycięzca finału zdobędzie puchar</small>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Lista uczestników i rozstawienie -->
<div class="card card-custom">
    <div class="card-header bg-white py-3">
        <h5 class="mb-0 fw-bold"><i class="bi bi-people text-secondary me-2"></i>Uczestnicy turnieju i rozstawienie</h5>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive" style="max-height: 400px; overflow-y: auto;">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light small sticky-top">
                    <tr>
                        <th style="width: 80px;" class="text-center">Seed (#)</th>
                        <th>Pseudonim gracza</th>
                        <th class="text-end">Profil</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model.Participants)
                    {
                        <tr>
                            <td class="text-center fw-bold">#@p.Seed</td>
                            <td class="fw-semibold">
                                <i class="bi bi-person-fill text-primary me-1"></i> @p.Nickname
                            </td>
                            <td class="text-end">
                                <a asp-controller="Players" asp-action="Details" asp-route-id="@p.PlayerId" class="btn btn-sm btn-outline-secondary">
                                    Zobacz profil
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@if (User.IsInRole("Admin"))
{
    <!-- Modal do wpisywania wyników meczów pucharowych -->
    <div class="modal fade" id="tourScoreModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <form asp-action="RecordMatchScore" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="tournamentId" value="@Model.Id" />
                    <input type="hidden" id="modalTourMatchId" name="tournamentMatchId" value="" />

                    <div class="modal-header">
                        <h5 class="modal-title fw-bold" id="modalTourRoundTitle">Wprowadź wynik meczu</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Zamknij"></button>
                    </div>
                    <div class="modal-body text-center">
                        <p class="text-muted small">Race to @Model.RaceTo (zwycięzca musi zdobyć dokładnie @Model.RaceTo partii i automatycznie awansuje)</p>
                        <div class="row align-items-center justify-content-center my-3">
                            <div class="col-5">
                                <label id="modalTourP1Name" class="form-label fw-bold"></label>
                                <input type="number" id="modalTourP1Score" name="player1Score" value="0" min="0" max="@Model.RaceTo" class="form-control form-control-lg text-center fs-3 fw-bold" required />
                            </div>
                            <div class="col-2 fs-3 fw-bold text-muted">:</div>
                            <div class="col-5">
                                <label id="modalTourP2Name" class="form-label fw-bold"></label>
                                <input type="number" id="modalTourP2Score" name="player2Score" value="0" min="0" max="@Model.RaceTo" class="form-control form-control-lg text-center fs-3 fw-bold" required />
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Anuluj</button>
                        <button type="submit" class="btn btn-success fw-semibold">Zapisz i awansuj</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        // Rysowanie połączeń między meczami (drabinka turniejowa)
        function drawBracketConnections() {
            const stage = document.getElementById('tournamentBracketStage');
            const svg = document.getElementById('tournamentBracketSvg');
            const pathsGroup = document.getElementById('bracketPathsGroup');
            if (!stage || !svg || !pathsGroup) return;

            // Wyczyść poprzednie linie
            pathsGroup.innerHTML = '';

            const stageRect = stage.getBoundingClientRect();
            const matchNodes = document.querySelectorAll('.tournament-node[data-match-id]');
            const championNode = document.getElementById('tournamentChampionNode');

            if (matchNodes.length === 0) return;

            const allRounds = Array.from(matchNodes).map(n => parseInt(n.dataset.round || '1'));
            const maxRound = Math.max(...allRounds);

            matchNodes.forEach(sourceNode => {
                const matchId = sourceNode.dataset.matchId;
                const nextMatchId = sourceNode.dataset.nextMatchId;
                const nextSlot = sourceNode.dataset.nextSlot;
                const isCompleted = sourceNode.dataset.completed === 'true';
                const winnerId = sourceNode.dataset.winnerId;
                const roundNum = parseInt(sourceNode.dataset.round || '1');

                let targetNode = null;
                let isChampionConnection = false;

                if (nextMatchId) {
                    targetNode = document.getElementById('tmatch-' + nextMatchId);
                } else if (championNode && roundNum === maxRound) {
                    targetNode = championNode;
                    isChampionConnection = true;
                }

                if (!targetNode) return;

                const sourceRect = sourceNode.getBoundingClientRect();
                const targetRect = targetNode.getBoundingClientRect();

                // 1. Punkt początkowy (x1, y1)
                let x1 = sourceRect.right - stageRect.left;
                let y1 = sourceRect.top + sourceRect.height / 2 - stageRect.top;

                // Jeśli mecz zakończony i znany jest zwycięzca, zaczynamy dokładnie z wiersza wygranego gracza!
                if (isCompleted && winnerId) {
                    const p1Slot = sourceNode.querySelector('.slot-1');
                    const p2Slot = sourceNode.querySelector('.slot-2');
                    if (p1Slot && p1Slot.dataset.playerId === winnerId) {
                        const r = p1Slot.getBoundingClientRect();
                        y1 = r.top + r.height / 2 - stageRect.top;
                        x1 = r.right - stageRect.left;
                    } else if (p2Slot && p2Slot.dataset.playerId === winnerId) {
                        const r = p2Slot.getBoundingClientRect();
                        y1 = r.top + r.height / 2 - stageRect.top;
                        x1 = r.right - stageRect.left;
                    }
                }

                // 2. Punkt docelowy (x2, y2)
                let x2 = targetRect.left - stageRect.left;
                let y2 = targetRect.top + targetRect.height / 2 - stageRect.top;

                if (!isChampionConnection) {
                    if (nextSlot === '1') {
                        const slot1 = targetNode.querySelector('.slot-1');
                        if (slot1) {
                            const r = slot1.getBoundingClientRect();
                            x2 = r.left - stageRect.left;
                            y2 = r.top + r.height / 2 - stageRect.top;
                        }
                    } else if (nextSlot === '2') {
                        const slot2 = targetNode.querySelector('.slot-2');
                        if (slot2) {
                            const r = slot2.getBoundingClientRect();
                            x2 = r.left - stageRect.left;
                            y2 = r.top + r.height / 2 - stageRect.top;
                        }
                    }
                }

                // 3. Geometria ścieżki (ortogonalna z zaokrąglonymi narożnikami)
                const dx = Math.max(20, x2 - x1);
                const xmid = x1 + dx * 0.5;
                const dy = y2 - y1;
                const radius = Math.min(10, Math.abs(dy) / 2, dx / 4);

                let pathD = '';
                if (Math.abs(dy) < 2) {
                    pathD = `M ${x1} ${y1} L ${x2} ${y2}`;
                } else if (dy > 0) {
                    pathD = `M ${x1} ${y1} L ${xmid - radius} ${y1} Q ${xmid} ${y1} ${xmid} ${y1 + radius} L ${xmid} ${y2 - radius} Q ${xmid} ${y2} ${xmid + radius} ${y2} L ${x2} ${y2}`;
                } else {
                    pathD = `M ${x1} ${y1} L ${xmid - radius} ${y1} Q ${xmid} ${y1} ${xmid} ${y1 - radius} L ${xmid} ${y2 + radius} Q ${xmid} ${y2} ${xmid + radius} ${y2} L ${x2} ${y2}`;
                }

                // Bazowa linia struktury drabinki (szara, przerywana dla nierozegranych)
                const baseLine = document.createElementNS('http://www.w3.org/2000/svg', 'path');
                baseLine.setAttribute('d', pathD);
                baseLine.setAttribute('class', 'bracket-line-base');
                baseLine.setAttribute('stroke', '#cbd5e1');
                baseLine.setAttribute('stroke-width', '2');
                baseLine.setAttribute('fill', 'none');
                baseLine.setAttribute('stroke-linecap', 'round');
                baseLine.setAttribute('stroke-linejoin', 'round');
                if (!isCompleted) {
                    baseLine.setAttribute('stroke-dasharray', '5 4');
                    baseLine.setAttribute('marker-end', 'url(#arrow-pending)');
                }
                pathsGroup.appendChild(baseLine);

                // Linia awansu zwycięzcy (zielona, podświetlona, ze strzałką do następnego etapu)
                if (isCompleted && winnerId) {
                    const winLine = document.createElementNS('http://www.w3.org/2000/svg', 'path');
                    winLine.setAttribute('d', pathD);
                    winLine.setAttribute('class', isChampionConnection ? 'bracket-line-champion' : 'bracket-line-winner');
                    winLine.setAttribute('stroke', isChampionConnection ? '#f59e0b' : '#10b981');
                    winLine.setAttribute('stroke-width', isChampionConnection ? '3.5' : '3');
                    winLine.setAttribute('fill', 'none');
                    winLine.setAttribute('stroke-linecap', 'round');
                    winLine.setAttribute('stroke-linejoin', 'round');
                    winLine.setAttribute('marker-end', isChampionConnection ? 'url(#arrow-champion)' : 'url(#arrow-winner)');
                    if (!isChampionConnection) {
                        winLine.setAttribute('filter', 'url(#glow-winner)');
                    }
                    winLine.dataset.sourceMatchId = matchId;
                    winLine.dataset.targetMatchId = targetNode.dataset.matchId || 'champion';
                    pathsGroup.appendChild(winLine);
                }
            });
        }

        // Interaktywne podświetlanie ścieżek po najechaniu myszą na mecz
        function initBracketHover() {
            document.querySelectorAll('.tournament-node[data-match-id]').forEach(node => {
                node.addEventListener('mouseenter', () => {
                    const matchId = node.dataset.matchId;
                    document.querySelectorAll(`path[data-source-match-id="${matchId}"], path[data-target-match-id="${matchId}"]`).forEach(p => {
                        p.classList.add('bracket-line-highlight');
                    });
                });
                node.addEventListener('mouseleave', () => {
                    document.querySelectorAll('.bracket-line-highlight').forEach(p => {
                        p.classList.remove('bracket-line-highlight');
                    });
                });
            });
        }

        // Szybkie przewijanie drabinki
        function initScrollControls() {
            document.querySelectorAll('.js-scroll-round').forEach(btn => {
                btn.addEventListener('click', () => {
                    const wrapper = document.getElementById('tournamentBracketWrapper');
                    if (!wrapper) return;
                    if (btn.dataset.target === 'first') {
                        wrapper.scrollTo({ left: 0, behavior: 'smooth' });
                    } else if (btn.dataset.target === 'last') {
                        wrapper.scrollTo({ left: wrapper.scrollWidth, behavior: 'smooth' });
                    }
                });
            });
        }

        // Inicjalizacja i obsługa przerysowania przy zmianie rozmiaru
        window.addEventListener('DOMContentLoaded', () => {
            drawBracketConnections();
            initBracketHover();
            initScrollControls();
        });

        window.addEventListener('load', () => {
            drawBracketConnections();
        });

        let resizeTimer;
        window.addEventListener('resize', () => {
            clearTimeout(resizeTimer);
            resizeTimer = setTimeout(drawBracketConnections, 100);
        });

        if (window.ResizeObserver) {
            const ro = new ResizeObserver(() => {
                drawBracketConnections();
            });
            const stageEl = document.getElementById('tournamentBracketStage');
            if (stageEl) ro.observe(stageEl);
        }

        // Modal dla Admina
        function openTournamentScoreModal(matchId, p1Name, p2Name, s1, s2, roundName) {
            const modalEl = document.getElementById('tourScoreModal');
            if (!modalEl) return;
            document.getElementById('modalTourMatchId').value = matchId;
            document.getElementById('modalTourRoundTitle').textContent = 'Wynik meczu: ' + roundName;
            document.getElementById('modalTourP1Name').textContent = p1Name;
            document.getElementById('modalTourP2Name').textContent = p2Name;
            document.getElementById('modalTourP1Score').value = s1;
            document.getElementById('modalTourP2Score').value = s2;
            new bootstrap.Modal(modalEl).show();
        }

        document.querySelectorAll('.js-tournament-score').forEach(function (button) {
            button.addEventListener('click', function () {
                openTournamentScoreModal(
                    button.dataset.matchId,
                    button.dataset.player1,
                    button.dataset.player2,
                    button.dataset.score1,
                    button.dataset.score2,
                    button.dataset.round);
            });
        });
    </script>
}
